# ========================================================
# EKET CYBERVERSE ENVIRONMENT CONFIGURATION
# Heartcode Technologies
# "From Security Intelligence to Verified Resilience."
# ========================================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000/api
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="file:./dev.db"

# Security & Session Authentication
JWT_SECRET=eket_cyberverse_secure_jwt_token_key_change_in_production_9982!
JWT_REFRESH_SECRET=eket_cyberverse_secure_refresh_key_change_in_production_7712!
TOKEN_EXPIRATION="24h"

# Optional AI Security Copilot (Google Gemini / Anthropic)
# Server-side only - Never exposed to frontend clients
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Advisory Ingestion Feed Refresh (minutes)
ADVISORY_SYNC_INTERVAL_MINUTES=60
