{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm install --prefix backend --legacy-peer-deps && npm run build --prefix backend",
    "watchPatterns": ["backend/src/**"]
  },
  "deploy": {
    "startCommand": "npm start --prefix backend",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100
  }
}
